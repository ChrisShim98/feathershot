<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Feathershot.ToastWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Feathershot">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" Background="Transparent" Padding="14,12" ColumnSpacing="14"
          PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" PointerPressed="OnPointerPressed">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="64" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Width="64" Height="64" CornerRadius="12" BorderThickness="1"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
            <Image x:Name="Thumb" Stretch="UniformToFill" />
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock x:Name="ToastTitle" Text="Beautify?" FontSize="18" FontWeight="ExtraBold" />
            <TextBlock x:Name="Subtitle" Text="Click to open in Feathershot" FontSize="12" Opacity="0.65" />
        </StackPanel>

        <!-- The mascot: a round bird with one bright tail feather. Original artwork, 100x100 design grid. -->
        <Viewbox x:Name="BirdBox" Grid.Column="2" Width="52" Height="52" VerticalAlignment="Center">
            <Canvas Width="100" Height="100">
                <Path Fill="#FB7185" Data="M26,48 C10,42 5,26 12,10 C25,18 30,34 26,48 Z" />
                <Path Stroke="#FB923C" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M42,84 L42,90 M56,84 L56,90" />
                <Ellipse Canvas.Left="18" Canvas.Top="26" Width="60" Height="60">
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2DD4BF" Offset="0" />
                            <GradientStop Color="#7C6CF0" Offset="1" />
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Fill="#FFF7ED" Canvas.Left="27" Canvas.Top="52" Width="38" Height="30" />
                <Ellipse Fill="#8B5CF6" Opacity="0.85" Canvas.Left="23" Canvas.Top="51" Width="22" Height="14">
                    <Ellipse.RenderTransform><RotateTransform Angle="-25" CenterX="11" CenterY="7" /></Ellipse.RenderTransform>
                </Ellipse>
                <Path Fill="#FB923C" Data="M74,50 L90,55 L74,60 Z" />
                <Ellipse Fill="#1F1B2E" Canvas.Left="53.4" Canvas.Top="41.4" Width="9.2" Height="9.2" />
                <Ellipse Fill="White" Canvas.Left="58.2" Canvas.Top="43" Width="2.8" Height="2.8" />
                <Ellipse Fill="#FB7185" Opacity="0.45" Canvas.Left="60" Canvas.Top="51" Width="8" Height="8" />
            </Canvas>
        </Viewbox>
    </Grid>
</Window>
